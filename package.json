{
  "name": "looping-starter",
  "version": "0.1.0",
  "private": true,
  "description": "A working, deployable Looping agent on Cloudflare Workers. Five example agents mounted in one Worker, on @loopingai/core and @loopingai/plugins.",
  "license": "GPL-3.0-only",
  "author": "Looping AI",
  "homepage": "https://github.com/Looping-AI/looping-starter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Looping-AI/looping-starter.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "keygen": "looping-keys",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check": "wrangler types --check && prettier --check . && eslint . && tsc && tsc -p test/tsconfig.json && node scripts/verify-references.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:record": "RECORD=1 vitest run recorded.spec.ts",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "verify:references": "node scripts/verify-references.mjs",
    "link:local": "node scripts/link-local.mjs",
    "cf": "node scripts/cf.mjs",
    "prepare": "husky",
    "agent:new": "node scripts/agent.mjs new",
    "agent:remove": "node scripts/agent.mjs remove"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0.1",
    "@cloudflare/computer": "^0.2.1",
    "@cloudflare/shell": "0.4.3",
    "@loopingai/core": "^0.8.3",
    "@loopingai/plugins": "^0.7.0",
    "@platformatic/vfs": "^0.4.0",
    "agents": "^0.20.1",
    "ai": "^7.0.52",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "sharp": false,
    "workerd": false,
    "core-js-pure": false,
    "@mongodb-js/zstd": false
  }
}

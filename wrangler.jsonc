/**
 * One Worker, five agents.
 *
 * The agents are **tenants** of one deployment, routed by `src/index.ts` on the
 * A2A `params.tenant` — they share one origin, one `/a2a` endpoint, one signed
 * AgentCard, one JWKS and one signing key. What they do *not* share is what is
 * configured below: each gets its own Durable Object class and its own Workflow
 * binding. Blocks are grouped per agent so deleting one is a comment-out rather
 * than a puzzle — see "Delete what you don't want" in the README for the full
 * three-step removal.
 *
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "looping-starter",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-06",
  "compatibility_flags": ["nodejs_compat"],
  // Headroom for git, which now runs here rather than in the container.
  //
  // `@cloudflare/computer/git` is isomorphic-git: SHA-1 and inflate in
  // JavaScript, on this Worker's CPU budget rather than a container's. Measured
  // before setting this, shallow and single-branch — a 485-file repository
  // clones in ~1.1 s and a 5,456-file monorepo in ~5.5 s wall-clock, most of it
  // network — so the default 30 s is not close to binding. This is for the
  // repository that is an order of magnitude past those, not for the ones that
  // were measured; a clone that dies at 30 s costs a whole task.
  "limits": { "cpu_ms": 300000 },
  "observability": {
    "enabled": true,
    // Traces, not just logs. The coder's workspace passes
    // `createCloudflareObserver({ tracing })` to its `Workspace`, which emits a
    // span per sync push, sync pull, exec spawn and filesystem operation. Those
    // are the only view into how long a container→host sync actually takes, and
    // without this flag `tracing` is undefined and the observer silently
    // degrades to a no-op.
    "traces": {
      "enabled": true
    }
  },

  // No `vars` and no model credential anywhere in this file — every agent reaches
  // Workers AI through the `AI` binding below, which the platform authenticates.
  // See the secrets block at the bottom for what remains and what was removed.

  // --- shared: required by core itself -------------------------------------

  // Workers AI backs every agent's tool loop (via AI Gateway). `remote: true`
  // reflects reality — Workers AI has no local execution mode and always hits
  // remote resources — and suppresses wrangler's per-run warning. In tests the
  // pool-level `remoteBindings: false` (vitest.config.ts) overrides this and
  // keeps the suite from eagerly opening that remote connection.
  "ai": {
    "binding": "AI",
    "remote": true
  },

  // --- plugin-required bindings --------------------------------------------
  // A plugin cannot add its own wrangler binding, which is the whole reason it
  // declares `requires`. Each of these is asserted at DO start by
  // `createAgentRuntime({ env })`, so a missing one fails with a sentence naming
  // the plugin rather than at the first tool call, inside a request someone is
  // waiting on.

  // The coder's workspace container, running `computerd` (see Dockerfile).
  // Requires a PAID Workers plan.
  //
  // `class_name` is the Durable Object that *owns* the container, one-to-one:
  // `@cloudflare/computer` pairs each object's SQLite filesystem with exactly
  // one container, which is what makes "one workspace per repository" a
  // structural property rather than a convention.
  //
  // `instance_type` is deliberately not "lite": that is the getting-started
  // default and cannot build a real project.
  //
  // The CPU is the exposure, and it was measured: on standard-1 (1/2 vCPU,
  // 4 GiB) a one-line README change took 59 minutes, of which 52 were inside
  // `executeChunk` at **0.0% of Worker CPU** — the Worker was asleep awaiting
  // this container the whole time.
  // `npm run check` on the target repo is five sequential tools including two
  // full `tsc` runs; it is recorded at 28 s in `src/workspace/install-plan.ts`
  // and was observed taking 3-5 minutes here.
  //
  // standard-2 is 1 vCPU, 6 GiB, 12 GB disk — double the CPU. It is headroom
  // rather than a cure: the same run also lost ten minutes to a step timeout and
  // ran every model call on a rate-limited primary, and both of those are fixed
  // elsewhere (see `platform.ts` and `config.ts`). If the install gate is still
  // measured above ~3 minutes, standard-3 (2 vCPU, 8 GiB) is the next step, and
  // that measurement is what should justify it.
  //
  // **Two entries, one Dockerfile.** Cloudflare builds once per entry, so naming
  // the same file twice produces two images — and `image_vars` is a Docker build
  // arg, which is how only one of them gets the Claude Code CLI.
  //
  // `max_instances` is per entry, so the ceiling is the sum across both entries,
  // not the number on either line. A container bills by the second and each agent
  // keys one per caller per repository.
  "containers": [
    {
      "class_name": "CoderWorkspaceDO",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 5
    },
    {
      "class_name": "ClaudeCoderWorkspaceDO",
      "image": "./Dockerfile",
      // **Pinned, and the pin is load-bearing.** The egress gateway rewrites
      // this client's requests and `events.ts` parses its stream; both are
      // written against a wire shape captured from this exact version. A bump
      // needs the smoke test re-run — see the Dockerfile.
      "image_vars": { "CLAUDE_CODE_VERSION": "2.1.238" },
      "instance_type": "standard-2",
      "max_instances": 5
    }
  ],

  // There is deliberately **no R2 bucket here**, and it is worth saying why,
  // because a `BACKUP_BUCKET` binding looks like an obvious thing to add.
  //
  // The coder used to snapshot its container's `/workspace` to R2 between tasks
  // so a follow-up skipped the clone and the install. It never worked once in
  // production: `@cloudflare/sandbox` mounts that archive **inside the
  // container** over s3fs, so it needs R2 S3-API credentials
  // (`R2_ACCESS_KEY_ID` and friends) that a Workers R2 binding cannot supply —
  // the binding has no presign API. Every task logged `InvalidBackupConfigError`.
  //
  // Nothing replaces it, because nothing needs to: the checkout now lives in the
  // workspace object's own SQLite storage, which survives the container and
  // costs no credential at all. `node_modules` does not — it stays in the
  // container and is reinstalled when one starts — but that is reproducible from
  // the lockfile in a few minutes, which is exactly what a snapshot was ever
  // worth. See `src/workspace/install-plan.ts`.

  // `@loopingai/plugins/browser` — used by reactive and arc-player.
  // NOTE: requires a PAID Workers plan; Browser Rendering is not on the free
  // tier. `remote: true` is required for Quick Actions under `wrangler dev`.
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },

  // `@loopingai/plugins/recall` — used by reactive and proactive. Must be a
  // 1024-dim cosine index to match the `@cf/baai/bge-m3` embedding model.
  // Vectorize has no local mode, so tests inject a fake index.
  //   wrangler vectorize create looping-starter-recall --dimensions=1024 --metric=cosine
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "looping-starter-recall",
      "remote": true
    }
  ],

  // --- the agents ----------------------------------------------------------
  // One Durable Object class per agent: each is keyed by the verified caller
  // (`identity.key`), holding that caller's SQLite-backed Session — continuous
  // history plus writable memory.
  //
  // `ReactiveSubagent` / `ArcPlayerSubagent` are deliberately absent. Each is a
  // managed facet created beneath ReactiveAgent/ArcPlayerAgent, so it needs no
  // binding and no `new_sqlite_classes` entry; it only has to be exported from
  // src/index.ts so `ctx.exports` can resolve it by class name. They DO need a
  // test-only binding — see the comment in vitest.config.ts.
  "durable_objects": {
    "bindings": [
      { "class_name": "ReactiveAgent", "name": "ReactiveAgent" },
      { "class_name": "ProactiveAgent", "name": "ProactiveAgent" },
      { "class_name": "ArcPlayerAgent", "name": "ArcPlayerAgent" },
      { "class_name": "CoderAgent", "name": "CoderAgent" },
      { "class_name": "ClaudeCoderAgent", "name": "ClaudeCoderAgent" },

      // Not agents — the two workspaces. One object per caller per repository,
      // holding that checkout's filesystem in SQLite and owning the container
      // that mounts it. Addressed by `idFromName`, never by the caller alone;
      // see `workspaceName` in `src/workspace/object.ts`, which both share.
      //
      // Two classes rather than one shared class with two bindings, because a
      // Durable Object namespace is keyed by class name: one class would put
      // both agents' checkouts in one namespace, and a caller working on the
      // same repository through both would get one container for both.
      { "class_name": "CoderWorkspaceDO", "name": "CODER_WORKSPACE" },
      {
        "class_name": "ClaudeCoderWorkspaceDO",
        "name": "CLAUDE_CODER_WORKSPACE"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ReactiveAgent",
        "ProactiveAgent",
        "ArcPlayerAgent"
      ]
    },
    {
      // A NEW tag, not an addition to "v1". Migrations are applied by tag and
      // never re-applied, so a class appended to an already-deployed tag is
      // simply never created — and the failure surfaces at runtime as a missing
      // Durable Object, far from this file. `agent:new` appends to the last tag
      // because it cannot know whether you have deployed; when you have, split
      // it out like this.
      "tag": "v2",
      "new_sqlite_classes": ["CoderAgent", "Sandbox"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["CoderWorkspaceDO"]
    },
    {
      // Its own tag, and this is the second time that rule has earned its
      // comment. `deleted_classes` was first appended to "v3" — which was
      // already deployed, so it was simply never applied, and the deploy failed
      // with "New version of script does not export class 'Sandbox' which is
      // depended on by existing Durable Objects". A tag is applied once, ever.
      //
      // `Sandbox` is gone from the code, and removing a class without saying so
      // reclaims nothing: it leaves every object that class created holding its
      // storage, unreachable and still billed. This is the line that frees them,
      // and it is irreversible — those container filesystems were never the
      // source of truth for anything, which was the whole problem with them.
      "tag": "v4",
      "deleted_classes": ["Sandbox"]
    },
    {
      // The third time the "a tag is applied once, ever" rule has earned a
      // comment, and the first where the tooling walked into it: `agent:new`
      // appended `ClaudeCoderAgent` to **v1**, because it cannot know which tags
      // have been deployed. v1 has, so the class would simply never have been
      // created — and that surfaces at the first request to the agent, not at
      // deploy. It was moved here by hand.
      //
      // Both classes in one tag because they arrive together: the agent and the
      // workspace it owns.
      "tag": "v5",
      "new_sqlite_classes": ["ClaudeCoderAgent", "ClaudeCoderWorkspaceDO"]
    }
  ],

  // Async A2A (accept + notify): the Worker accepts a turn synchronously and
  // hands generation plus the gateway push-notification callback to a durable
  // Workflow. Reactive and arc-player run the same round loop over different
  // souls and plugins, so they share one workflow body behind two entrypoints.
  "workflows": [
    {
      "binding": "HANDLE_TASK_WORKFLOW",
      "name": "handle-task",
      "class_name": "HandleTaskWorkflow"
    },
    {
      "binding": "ARC_HANDLE_TASK_WORKFLOW",
      "name": "arc-handle-task",
      "class_name": "ArcHandleTaskWorkflow"
    },
    {
      "binding": "NOTIFY_WORKFLOW",
      "name": "notify-task",
      "class_name": "NotifyTaskWorkflow"
    },
    {
      "binding": "CODER_WORKFLOW",
      "name": "coder",
      "class_name": "CoderWorkflow"
    },
    {
      "binding": "CLAUDE_CODER_WORKFLOW",
      "name": "claude-coder",
      "class_name": "ClaudeCoderWorkflow"
    }
  ],

  // --- secrets --------------------------------------------------------------
  // One signing key for the deployment, not one per agent. The card is
  // per-origin (a well-known URI is per-authority), so the key a gateway pins is
  // too. Nothing was lost by collapsing three into one: the agents share this
  // Worker and this `env`, so each could always read the others' keys — separate
  // ones never expressed a boundary that existed. Generate with `npm run keygen`.
  //
  // What does separate them is the gateway token's tenant claim, which core
  // checks against the tenant each request addresses.
  //
  // `GATEWAY_ORIGINS` is the allowlist of gateways this Worker accepts calls
  // from — a property of the deployment, like the key.
  //
  // **There is no model credential here, for any agent.** Every agent in this
  // Worker reaches Workers AI through the `AI` binding above, which Cloudflare
  // authenticates for the Worker — there is no key to store, rotate or leak, and
  // the coder's container has never seen one either.
  //
  // Two secrets used to sit here and are gone as of 2026-08-20, when the coder
  // moved off Claude:
  //
  //   - `ANTHROPIC_PROXY_ORIGIN` named a separate Worker that held the Anthropic
  //     credential and was reached through an AI Gateway custom provider.
  //   - `AI_GATEWAY_TOKEN` authenticated this Worker *to* the gateway, and was
  //     needed only because that path called a gateway URL directly rather than
  //     going through the binding.
  //
  // Neither has a replacement. If a `401` ever surfaces from the gateway now, it
  // means Authenticated Gateway is switched on for the configured `aiGatewayId`
  // and should be switched off — the binding does not send a token. See
  // `CREDENTIAL_COPY` in `src/agents/coder/workflow.ts`.
  "secrets": {
    "required": [
      "A2A_SIGNING_KEY",
      "GATEWAY_ORIGINS",
      "ARC_API_KEY",
      // Both coders. `GITHUB_TOKEN` needs contents and pull-request write.
      //
      // It is read exclusively inside a workspace object, never crosses an RPC
      // argument, and never enters the container — `onAuth` checks the host
      // allowlist at the moment the token is handed over.
      "GITHUB_TOKEN",

      // claude-coder only, and **a pool rather than a secret**: entry 1 is used
      // until Anthropic says its 5-hour or weekly bucket is spent, then the
      // egress gateway rotates to entry 2 and, when both are spent, reports the
      // reset time and stops. Order is priority.
      //
      // Both are `claude setup-token` OAuth credentials, and **both are listed
      // because this deployment has two**. `secrets.required` drives type
      // generation and `wrangler dev`'s missing-secret warnings, so a name left
      // here and unset is typed as a definite string that is undefined at
      // runtime and warns on every local run. To run on one credential, drop
      // `_2` here *and* in `src/agents/claude-coder/claude-code.ts` — one
      // change, two places. (The `.filter(Boolean)` there is defence against an
      // unset secret, not a licence to leave one declared.)
      //
      // Rotating either secret works as you would expect: the pool keys its
      // spent/rejected state on a fingerprint of the credential, not on its
      // position, so a freshly minted token is tried immediately rather than
      // inheriting the state of the one it replaced.
      //
      // **Neither ever enters the container.** They are read only inside
      // `ClaudeCoderWorkspaceDO`'s egress gateway, which swaps one into the
      // outbound request; the container is launched with a placeholder. That
      // matters more here than anywhere else in this file: the container runs a
      // cloned repository's `postinstall` and its test suite, so a `printenv` in
      // there is a `printenv` a stranger wrote.
      "CLAUDE_CODE_OAUTH_TOKEN_1",
      "CLAUDE_CODE_OAUTH_TOKEN_2"
    ]
  }
}

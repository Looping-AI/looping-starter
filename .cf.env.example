# Cloudflare API credentials for `npm run cf` (scripts/cf.mjs). Copy to
# `.cf.env` and fill in. `.cf.env` is gitignored — never commit real values.
#
# Deliberately NOT in `.env`: these are credentials for reading your
# Cloudflare account from your machine, not bindings the Worker gets. Keeping
# them in their own file means the token is never loaded into the Worker's env,
# never uploaded by `wrangler secret`, and never overrides your deploy auth.
#
# The script reads this file itself and holds the token in memory — it is never
# passed as an argv, so it stays out of your shell history and out of an agent's
# context, and any echo of it in an API response is redacted from the output.

# An account-scoped API token, created at
# https://dash.cloudflare.com/profile/api-tokens. For the subcommands this
# script implements, read-only permissions are enough:
#   Account · Workers Observability · Read   → `cf logs`, `cf fields`
#   Account · Workers Scripts · Read         → `cf wf`
#   Account · AI Gateway · Read              → `cf ai`
CLOUDFLARE_API_TOKEN=your-account-scoped-api-token

# Your account id — the hex string in any dashboard URL, or from
# `npx wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=your-account-id
